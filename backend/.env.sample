# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password  # Get this from Gmail's App Passwords
EMAIL_FROM=your-email@gmail.com

# AI Configuration
GROQ_API_KEY=your-groq-api-key  # Get this from https://console.groq.com

# Database Configuration
DATABASE_URL=sqlite:///./leads.db

# Server Configuration
CORS_ORIGINS=http://localhost:8080

# Proxy Configuration (Two options available)

## Option 1: Single Proxy
PROXY_URL=your-proxy-url  # Your proxy service URL
PROXY_USERNAME=your-proxy-username  # Optional: if proxy requires authentication
PROXY_PASSWORD=your-proxy-password  # Optional: if proxy requires authentication

## Option 2: Multiple Proxies (Recommended for better rate limit handling)
# Format: JSON array of proxy configurations in a single line
PROXY_LIST=[{"url":"http://proxy1.example.com:8080","username":"user1","password":"pass1"},{"url":"http://proxy2.example.com:8080","username":"user2","password":"pass2"}]

# Instructions:
# 1. Copy this file to .env
# 2. Replace the dummy values with your actual configuration
# 3. For Gmail:
#    - Enable 2-factor authentication
#    - Generate an App Password: Gmail > Settings > Security > App Passwords
# 4. For Groq:
#    - Sign up at https://console.groq.com
#    - Generate an API key from your dashboard
# 5. For Proxy (Required to avoid Google rate limiting):
#    - Sign up with a proxy service provider (e.g., Bright Data, ProxyCrawl)
#    - For better performance, use Option 2 (Multiple Proxies):
#      * Configure multiple proxy endpoints in PROXY_LIST as a single-line JSON array
#      * Each proxy should be a unique IP to maximize success rate
#      * The system will automatically rotate between proxies
#      * Failed proxies will be temporarily disabled
#    - If using Option 1 (Single Proxy):
#      * Set PROXY_URL to your proxy endpoint
#      * Format should be like "http://proxy.example.com:8080"
#      * Add authentication if required
